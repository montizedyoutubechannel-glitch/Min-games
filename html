<script src="https://telegram.org/js/telegram-web-app.js"></script>
<h1 id="s">0</h1>
<button onclick="tap()">Tap!</button>
<script>
  const tg = Telegram.WebApp; tg.ready(); tg.expand();
  let score = 0;
  function tap() {
    s.textContent = ++score;
    tg.HapticFeedback.impactOccurred("light");
  }
</script>
